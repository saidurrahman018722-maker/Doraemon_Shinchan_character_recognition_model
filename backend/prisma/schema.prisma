generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  displayName String
  series      String
  role        String
  color       String
  bio         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PredictionLog {
  id                 Int      @id @default(autoincrement())
  predictedCharacter String
  confidence         Float
  isCorrect          Boolean?
  createdAt          DateTime @default(now())
}
