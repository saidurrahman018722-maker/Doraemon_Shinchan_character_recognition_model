generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Character {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String
  series      String
  role        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PredictionLog {
  id                 Int      @id @default(autoincrement())
  predictedCharacter String
  confidence         Float
  isCorrect          Boolean?
  createdAt          DateTime @default(now())
}
